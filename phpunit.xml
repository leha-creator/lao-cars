<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Прогон целиком не помещается в умолчательные 128 МБ, и упирается
            он не в тест, который память съел, а в первый следующий,
            которому она понадобилась разом: GD держит распакованный растр,
            и загрузка снимка 1200×800 просит около 7 МБ одним куском.
            Падение выглядит как «сломался MediaResourceTest», хотя тот
            всего лишь оказался первым после набора, подошедшего к потолку.

            Поднимается здесь, а не в php.ini разработчика: иначе набор
            зелёный у одного и красный у другого, и разбираться в этом
            будет тот, кто просто дописал очередной тест.
        -->
        <ini name="memory_limit" value="512M"/>
        <!--
            Тесты ходят в реальные PostgreSQL и Redis, а не в SQLite и
            array-драйверы.

            Скелет Laravel задаёт здесь DB_CONNECTION=sqlite, DB_DATABASE=:memory:,
            CACHE_STORE=array, QUEUE_CONNECTION=sync и SESSION_DRIVER=array —
            действующими, а не закомментированными. Оставить их значит получить
            зелёные тесты, которые не касаются ни PostgreSQL, ни Redis, то есть
            не проверяют ровно то, ради чего smoke-тесты каркаса и написаны.

            Отдельно про QUEUE_CONNECTION: при `sync` job выполняется сразу и
            очередь всегда пуста, поэтому проверка реальной постановки задачи
            (`Queue::size() > 0`) молча теряет смысл.

            Хост, порт и учётные данные приходят из `.env` и здесь не дублируются —
            иначе локальное смещение порта Redis пришлось бы держать в двух местах.
        -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="redis"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="laocars_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="redis"/>
        <env name="SESSION_DRIVER" value="redis"/>
        <!--
            Изоляция от рабочих данных на стороне Redis. `default` обслуживает
            очередь и сессии, `cache` — кеш; у них разные номера баз, иначе
            тестовый прогон писал бы в ту же базу, где лежит кеш разработки
            (по умолчанию REDIS_CACHE_DB=1).
        -->
        <env name="REDIS_DB" value="1"/>
        <env name="REDIS_CACHE_DB" value="2"/>
        <!--
            Общий чат Telegram задан здесь с вехи 4.7, и это не декорация.

            До вехи задача уведомления диспатчилась безусловно. Теперь
            получателей выбирает `LeadNotifier`: персональные адреса
            сотрудников, а если их нет вовсе — фолбэк на этот общий чат.
            Тестовое окружение без него описывало бы состояние «о заявке
            не узнает никто», которого до вехи не существовало, и сторожа
            вехи 3.7 (`LeadStoreTest`) пришлось бы править под него.

            Значение фиктивное: токен при этом остаётся пустым, поэтому
            ни одного реального запроса в Telegram отсюда не уходит.
            Тесты, которым нужен пустой общий чат, обнуляют его через
            `config()` явно.
        -->
        <env name="TELEGRAM_MANAGER_CHAT_ID" value="100500"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
