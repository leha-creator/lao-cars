# Учётные данные PostgreSQL для `compose.production.yml`.
#
# Скопировать на сервере в `deploy/.env.docker` и заполнить пароль.
#
# Настоящий файл в git не попадает: `.gitignore` содержит строку
# `.env.docker`, и правило без слеша совпадает с именем файла в любом
# каталоге. Отдельная строка понадобилась потому, что существующее
# правило `.env` сравнивает имя ЦЕЛИКОМ и на `.env.docker` не
# распространяется — а этот же механизм оставляет трекаемым шаблон
# `.env.docker.example`, имя которого тоже другое. Проверка:
#
#     git check-ignore -v deploy/.env.docker          # должно совпасть
#     git check-ignore -v deploy/.env.docker.example  # должно молчать
#
# ПАРОЛЬ `secret` ИЗ ЛОКАЛЬНОГО compose.yml НА ПРОД НЕ ПЕРЕНОСИТСЯ.
# Сгенерировать новый:
#
#     openssl rand -base64 32
#
# Значения читаются PostgreSQL ТОЛЬКО при первичной инициализации
# пустого volume. Смена пароля в этом файле на уже созданной базе
# не делает ничего: контейнер поднимется, а приложение получит
# «password authentication failed» — при том, что файлы совпадают
# глазами. Менять пароль живой базы командой ALTER USER внутри
# контейнера, и синхронно править `.env` приложения.
#
# Те же три значения обязаны совпадать с DB_DATABASE, DB_USERNAME
# и DB_PASSWORD в `/var/www/laocars/.env`.

POSTGRES_DB=laocars
POSTGRES_USER=laocars
POSTGRES_PASSWORD=
